# Copiá a .env. La clave de Gemini se queda en el backend; nunca llega al navegador.
GEMINI_API_KEY=
# Verificá el ID vigente en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Transcripción: tiny | base | small | medium | large-v3 (más grande = más lento y más preciso)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=2048
CORS_ORIGINS=http://localhost:5173
